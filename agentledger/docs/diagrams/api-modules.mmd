        AgentCredentialsModule
        TenantIdpConfigModule
        ScimModule
        ScimTokensModule
        AllocationRulesModule
        VirtualKeysModule
        PriceBookModule
        TenantModule
    end

    subgraph analytics["Analytics"]
        AnalyticsModule
        AttributionModule
    end

    subgraph outcomeGraph["Outcome Graph MVP"]
        RunsModule
        OutcomesModule
    end

    subgraph ingestion["Bulk data ingestion"]
