        vendorDetail["/vendors/[vendorId]"]
        modelMix["/model-mix"]
        costPerOutcome["/cost-per-outcome"]
        attribution["/attribution"]
    end

    subgraph config["Governance / config"]
        allocation["/allocation"]
        budgets["/budgets"]
        roiTemplates["/roi-templates"]
        settings["/settings"]
        settingsConnectors["/settings/connectors"]
    end

    subgraph admin["Admin"]
        dataCoverage["/admin/data-coverage"]
        fixedOverhead["/admin/fixed-overhead"]
        billing["/admin/billing"]
    end

    subgraph entry["Auth / entry"]
        login["/login"]
        inviteAccept["/invite/accept"]
    end

    root --> exec
    root --> explore
    root --> config
    root --> admin
